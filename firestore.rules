rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // Helpers de identidad
    //
    // El dominio se valida contra una constante. Mantenlo sincronizado con la
    // variable VITE_ALLOWED_EMAIL_DOMAIN del front (sin la @ inicial).
    // Proyecto ENGIE: tierradeideas.mx
    // ────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@tierradeideas\\.mx$')
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAnySignedIn() {
      return request.auth != null;
    }

    function userPath(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.token.email);
    }

    function userExists(appId) {
      return isAuthenticated() && exists(userPath(appId));
    }

    function getUserData(appId) {
      return get(userPath(appId)).data;
    }

    function hasRole(appId, role) {
      return userExists(appId)
        && getUserData(appId).disabled != true
        && getUserData(appId).role == role;
    }

    function isITAdmin(appId) { return hasRole(appId, 'ADMIN_IT'); }
    function isCMAdmin(appId) { return hasRole(appId, 'ADMIN_CM'); }

    // ADMIN_IT y ADMIN_CM son los dos únicos roles válidos. El ADMIN_CM no
    // es IT Admin: NO tiene acceso a Backups Core, Auditoría SIEM ni a la
    // configuración del Microservicio.
    function isContentAdmin(appId) {
      return isITAdmin(appId) || isCMAdmin(appId);
    }

    // ────────────────────────────────────────────────────────────────────────
    // Validadores de esquema
    // ────────────────────────────────────────────────────────────────────────
    function isValidUser() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'role',
          'disabled', 'isProtected', 'lastLogin', 'preferences'
        ])
        && data.keys().hasAll(['email', 'displayName', 'lastLogin'])
        && data.email is string
        && data.displayName is string
        && (!('photoURL' in data) || data.photoURL is string || data.photoURL == null)
        && (!('role' in data) || (data.role is string && data.role in ['ADMIN_IT', 'ADMIN_CM']))
        && (!('disabled' in data) || data.disabled is bool)
        && (!('isProtected' in data) || data.isProtected is bool)
        && (!('preferences' in data) || data.preferences is map)
        && data.lastLogin is string;
    }

    // Incidencias Reputacionales (colección rrss_incidents)
    function isValidRRSSIncident() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'totalIncidencias', 'fecha', 'actorFuente', 'fuenteDeteccion', 'tipoFuente',
          'temaPrincipal', 'nivelRiesgoReputacional', 'alcanceActual', 'tendencia',
          'campus', 'resumenIncidente', 'hallazgosClave', 'enlacePublicacion',
          'enlaceDrive', 'reporteTexto', 'estado', 'autor', 'timestamp'
        ])
        && data.keys().hasAll([
          'fecha', 'actorFuente', 'fuenteDeteccion', 'nivelRiesgoReputacional',
          'estado', 'autor', 'timestamp'
        ])
        && data.fecha is string
        && data.autor is string
        && data.timestamp is string
        && data.fuenteDeteccion is string
        && data.nivelRiesgoReputacional in ['Bajo', 'Medio', 'Alto', 'Crítico']
        && data.estado in [
          'Monitoreo activo', 'En revisión', 'Seguimiento activo',
          'Resuelto / solucionado'
        ]
        && (!('totalIncidencias' in data) || data.totalIncidencias is number)
        && (!('reporteTexto' in data) || data.reporteTexto is string)
        && (!('resumenIncidente' in data) || data.resumenIncidente is string)
        && (!('hallazgosClave' in data) || data.hallazgosClave is string);
    }

    // Reportes de Menciones (colección comments) — modelo dual:
    //   - fuenteMonitoreo == 'Redes sociales'    → registrosList
    //   - fuenteMonitoreo == 'Medios digitales' → registrosDigitalesList
    function isValidCommentReport() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'fechaPublicacion', 'horaDeteccion', 'fuenteMonitoreo', 'evidencia',
          'registrosList', 'registrosDigitalesList', 'autor', 'timestamp'
        ])
        && data.keys().hasAll([
          'fechaPublicacion', 'fuenteMonitoreo', 'autor', 'timestamp'
        ])
        && data.fechaPublicacion is string
        && data.fuenteMonitoreo in ['Redes sociales', 'Medios digitales']
        && data.autor is string
        && data.timestamp is string
        && (!('horaDeteccion' in data) || data.horaDeteccion is string)
        && (!('evidencia' in data) || data.evidencia is string)
        && (
          (data.fuenteMonitoreo == 'Redes sociales'
            && (!('registrosList' in data) || data.registrosList is list)
            && !('registrosDigitalesList' in data))
          || (data.fuenteMonitoreo == 'Medios digitales'
            && (!('registrosDigitalesList' in data) || data.registrosDigitalesList is list)
            && !('registrosList' in data))
        );
    }

    function isValidNotification() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'userId', 'userName', 'userPhoto', 'action', 'module', 'type',
          'incidentId', 'timestamp', 'readBy', 'deletedBy', 'targetUserEmail'
        ])
        && data.keys().hasAll([
          'userId', 'userName', 'action', 'module', 'type',
          'timestamp', 'readBy', 'deletedBy'
        ])
        && data.userId is string
      && data.userName is string
      && data.action is string
      && data.module is string
      && data.type in ['create', 'edit', 'delete']
      && data.timestamp is string
      && data.readBy is list
      && data.deletedBy is list
      && (!('userPhoto' in data) || data.userPhoto is string)
      && (!('incidentId' in data) || data.incidentId is string)
      && (!('targetUserEmail' in data) || data.targetUserEmail is string);
    }

    // ────────────────────────────────────────────────────────────────────────
    // Reglas
    // ────────────────────────────────────────────────────────────────────────
    match /artifacts/{appId}/public/data {

      // Lockout de intentos fallidos de login. Escritura abierta.
      match /firewall_locks/{lockId} {
        allow read, write: if true;
      }

      // ── USERS ────────────────────────────────────────────────────────────
      match /users/{userEmail} {
        allow read: if isContentAdmin(appId)
                    || (isAuthenticated() && request.auth.token.email == userEmail);

        allow create: if (
          // Alta automática por primer login: el usuario del dominio crea su propio
          // doc SOLO con rol ADMIN_CM (auto-registro). Nunca ADMIN_IT.
          isAuthenticated()
          && request.auth.token.email == userEmail
          && request.resource.data.get('role', '') == 'ADMIN_CM'
          && request.resource.data.get('isProtected', false) != true
          && request.resource.data.get('disabled', false) != true
          && isValidUser()
        ) || isITAdmin(appId) || (
          isCMAdmin(appId)
          && request.resource.data.get('role', '') != 'ADMIN_IT'
          && request.resource.data.get('isProtected', false) != true
          && isValidUser()
        );

        allow update: if (
          isAuthenticated()
          && request.auth.token.email == userEmail
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'disabled', 'isProtected'])
          && isValidUser()
        ) || (
          isITAdmin(appId)
          && resource.data.get('isProtected', false) != true
          && isValidUser()
        ) || (
          isCMAdmin(appId)
          && resource.data.get('isProtected', false) != true
          && resource.data.get('role', '') != 'ADMIN_IT'
          && request.resource.data.get('role', '') != 'ADMIN_IT'
          && isValidUser()
        );

        allow delete: if isITAdmin(appId)
                      && resource.data.get('isProtected', false) != true;
      }

      // ── INCIDENCIAS REPUTACIONALES (rrss_incidents) ─────────────────────
      match /rrss_incidents/{incidentId} {
        allow read: if true;
        allow create: if isContentAdmin(appId) && isValidRRSSIncident();
        allow update: if isContentAdmin(appId)
                      && isValidRRSSIncident()
                      && request.resource.data.autor == resource.data.autor
                      && request.resource.data.timestamp == resource.data.timestamp
                      && request.resource.data.fecha == resource.data.fecha;
        allow delete: if isITAdmin(appId) || isCMAdmin(appId);
      }

      // ── REPORTES DE MENCIONES (comments) ────────────────────────────────
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isContentAdmin(appId) && isValidCommentReport();
        allow update: if isContentAdmin(appId)
                      && isValidCommentReport()
                      && request.resource.data.autor == resource.data.autor
                      && request.resource.data.timestamp == resource.data.timestamp;
        allow delete: if isITAdmin(appId) || isCMAdmin(appId);
      }

      // ── NOTIFICACIONES ──────────────────────────────────────────────────
      match /notifications/{notificationId} {
        allow read: if isAnySignedIn();
        allow create: if userExists(appId)
                      && isValidNotification()
                      && request.resource.data.userId == request.auth.uid;
        allow update: if userExists(appId) && (
          isContentAdmin(appId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy'])
        );
        allow delete: if isITAdmin(appId)
                      || (isAnySignedIn() && resource.data.userId == request.auth.uid);
      }

      // ── AUDIT LOGS (inmutables, lectura solo IT) ─────────────────────────
      match /auditLogs/{logId} {
        allow read: if isITAdmin(appId);
        allow create: if request.resource.data.keys().hasOnly([
            'ip', 'pais', 'fecha', 'uid', 'email',
            'provider', 'userAgent', 'accion', 'expireAt'
          ])
          && request.resource.data.ip is string
          && request.resource.data.pais is string
          && request.resource.data.fecha is timestamp
          && request.resource.data.expireAt is timestamp
          && request.resource.data.uid is string
          && request.resource.data.provider is string
          && request.resource.data.accion is string
          && request.resource.data.expireAt > request.time
          && request.resource.data.expireAt <= request.time + duration.value(14, 'd')
          && (
            (request.auth != null && request.resource.data.uid == request.auth.uid) ||
            (request.auth == null && request.resource.data.uid == 'anonymous_attacker')
          );
        allow update: if false;
        allow delete: if isITAdmin(appId);
      }

      // ── APP STATE (exclusivo IT) ────────────────────────────────────────
      match /appState/{docId} {
        allow read: if isAnySignedIn();
        allow write: if isITAdmin(appId);
      }

      // ── CONFIG DEL MICROSERVICIO (exclusivo IT) ─────────────────────────
      match /config/{document=**} {
        allow read: if isITAdmin(appId);
        allow write: if isITAdmin(appId);
      }
    }
  }
}



