# ============================================================
# ENVIROMENT TEMPLATE — Social Listening (White-Label / Zero-State)
# Copia este archivo a .env y completa los valores.
# VITE_USE_MOCK_DB=true  → desconecta Firebase (modo local dummy)
# VITE_USE_MOCK_DB=false → sincroniza con la base de datos real de Firebase
# ============================================================

# Modo desconectado (Zero-State): true ejecuta la app sin tocar Firebase
VITE_USE_MOCK_DB=

# Dominio permitido para autenticación por dominio (vacío = sin restricción)
VITE_ALLOWED_EMAIL_DOMAIN=

# ---- Credenciales Firebase (solo necesarias si VITE_USE_MOCK_DB=false) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=